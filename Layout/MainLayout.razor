@inherits LayoutComponentBase
@inject OperatorProfile Profile
@inject PortalStore Store
@inject NavigationManager Nav
@implements IDisposable

@if (!_ready)
{
    <div class="page" style="padding-top:20vh;text-align:center;">
        <p class="muted">Loading CrewHop…</p>
    </div>
}
else if (_onEntry)
{
    @Body
}
else
{
    <div class="shell">
        <aside class="sidebar">
            <div class="brand-lockup">
                <img class="logo" src="images/crewhop-logo-full.png" alt="CrewHop" />
                <span class="brand-tag">Business portal</span>
            </div>

            <nav class="nav-list" aria-label="Primary">
                <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                    <span class="nav-icon">▣</span> Dashboard
                </NavLink>
                <NavLink class="nav-link" href="venues">
                    <span class="nav-icon">⌂</span> Venues
                </NavLink>
                <NavLink class="nav-link" href="promotions">
                    <span class="nav-icon">◈</span> Promotions
                </NavLink>
                <NavLink class="nav-link" href="campaigns">
                    <span class="nav-icon">◎</span> Ad campaigns
                </NavLink>
            </nav>

            <div class="sidebar-footer">
                <div class="who">@_displayName</div>
                <div class="meta">@_email</div>
                <button class="btn btn-ghost btn-sm" style="width:100%;" @onclick="ExitAsync">Sign out</button>
            </div>
        </aside>

        <div class="main-panel">
            <div class="mobile-top">
                <div class="brand-lockup">
                    <img class="logo logo-sm" src="images/crewhop-logo-full.png" alt="CrewHop" />
                </div>
                <button class="btn btn-ghost btn-sm" @onclick="ExitAsync">Sign out</button>
            </div>
            <div class="page-titlebar">
                <h1 class="page-titlebar-label">@CurrentPageTitle</h1>
            </div>
            @Body
        </div>
    </div>
}

@code {
    private bool _ready;
    private bool _onEntry;
    private string _displayName = "";
    private string _email = "";

    private string CurrentPageTitle
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
            return path switch
            {
                "dashboard" => $"Welcome back, {_displayName.Split(' ').FirstOrDefault()}",
                "venues" => "Your venues",
                "promotions" => "Promotions",
                "campaigns" => "Ad campaigns",
                _ => "CrewHop"
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await Profile.EnsureHydratedAsync();
        await Store.EnsureLoadedAsync();
        RefreshProfileLabels();
        _ready = true;
        UpdateEntryFlag();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateEntryFlag();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateEntryFlag()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        _onEntry = string.IsNullOrEmpty(path) || path.Equals("login", StringComparison.OrdinalIgnoreCase);
    }

    private void RefreshProfileLabels()
    {
        _displayName = Profile.HasProfile ? Profile.DisplayName : Store.Business.OwnerName;
        _email = Profile.HasProfile ? Profile.Email : Store.Business.ContactEmail;
    }

    private async Task ExitAsync()
    {
        await Profile.ClearAsync();
        RefreshProfileLabels();
        Nav.NavigateTo("/");
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
