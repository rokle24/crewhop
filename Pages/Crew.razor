@page "/crew"
@inject PortalStore Store
@implements IDisposable

<PageTitle>Crew · CrewHop</PageTitle>

<section class="stack">
    <p class="lede">Roster loaded from demo seed and kept in browser storage.</p>

    @if (Store.Data.Crew.Count == 0)
    {
        <p class="empty-state">No crew members yet. Reset demo data from Potato promo if storage was cleared.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Role</th>
                        <th>Location</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Store.Data.Crew)
                    {
                        <tr>
                            <td>@member.Name</td>
                            <td>@member.Role</td>
                            <td>@member.Location</td>
                            <td><span class="pill">@member.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    protected override void OnInitialized() => Store.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.Changed -= OnChanged;
}
