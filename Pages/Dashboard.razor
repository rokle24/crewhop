@page "/dashboard"
@inject PortalStore Store
@implements IDisposable

<PageTitle>Dashboard · CrewHop</PageTitle>

@if (Store.Data.Dashboard is null)
{
    <p class="empty-state">Loading portal data…</p>
}
else
{
    <section class="stack">
        <p class="lede">Today’s fill pulse across active venues.</p>
        <div class="stat-grid">
            <article class="stat">
                <span class="stat-label">Active crew</span>
                <strong>@Store.Data.Dashboard.ActiveCrew</strong>
            </article>
            <article class="stat">
                <span class="stat-label">Open shifts</span>
                <strong>@Store.Data.Dashboard.OpenShifts</strong>
            </article>
            <article class="stat">
                <span class="stat-label">Filled today</span>
                <strong>@Store.Data.Dashboard.FilledToday</strong>
            </article>
            <article class="stat">
                <span class="stat-label">Fill rate</span>
                <strong>@Store.Data.Dashboard.FillRate.ToString("0.0")%</strong>
            </article>
        </div>

        <div class="split">
            <article class="panel">
                <h2>Upcoming shifts</h2>
                @if (Store.Data.Shifts.Count == 0)
                {
                    <p class="empty-state">No shifts in demo data.</p>
                }
                else
                {
                    <ul class="plain-list">
                        @foreach (var shift in Store.Data.Shifts.Take(3))
                        {
                            <li>
                                <strong>@shift.Title</strong>
                                <span>@shift.Location · @FormatWhen(shift.StartsAt)</span>
                            </li>
                        }
                    </ul>
                }
            </article>
            <article class="panel accent">
                <h2>Potato promo</h2>
                <p>@Store.Data.PotatoPromo.Headline</p>
                <a class="text-link" href="potato-promo">Open promo desk →</a>
            </article>
        </div>
    </section>
}

@code {
    protected override void OnInitialized() => Store.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.Changed -= OnChanged;

    private static string FormatWhen(string iso)
        => DateTime.TryParse(iso, out var dt) ? dt.ToString("ddd d MMM · HH:mm") : iso;
}
