@page "/"
@page "/login"
@inject OperatorProfile Profile
@inject NavigationManager Nav

<PageTitle>Sign in · CrewHop</PageTitle>

<div class="login-screen">
    <section class="login-visual" aria-hidden="false">
        <div class="login-visual-grain" aria-hidden="true"></div>
        <div class="login-visual-motif" aria-hidden="true">
            <svg viewBox="0 0 520 420" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Soft evening streetscape: storefront blocks + warm window lights -->
                <g opacity="0.55">
                    <rect x="48" y="168" width="92" height="170" rx="10" fill="currentColor" opacity="0.14" />
                    <rect x="156" y="128" width="118" height="210" rx="12" fill="currentColor" opacity="0.18" />
                    <rect x="292" y="152" width="100" height="186" rx="10" fill="currentColor" opacity="0.15" />
                    <rect x="408" y="112" width="88" height="226" rx="12" fill="currentColor" opacity="0.2" />
                </g>
                <g fill="#E7D0AA">
                    <rect x="68" y="198" width="22" height="28" rx="4" opacity="0.55" />
                    <rect x="98" y="198" width="22" height="28" rx="4" opacity="0.35" />
                    <rect x="68" y="240" width="22" height="28" rx="4" opacity="0.28" />
                    <rect x="98" y="240" width="22" height="28" rx="4" opacity="0.45" />
                    <rect x="178" y="168" width="28" height="36" rx="5" opacity="0.6" />
                    <rect x="216" y="168" width="28" height="36" rx="5" opacity="0.38" />
                    <rect x="178" y="216" width="28" height="36" rx="5" opacity="0.32" />
                    <rect x="216" y="216" width="28" height="36" rx="5" opacity="0.5" />
                    <rect x="312" y="188" width="24" height="30" rx="4" opacity="0.42" />
                    <rect x="344" y="188" width="24" height="30" rx="4" opacity="0.58" />
                    <rect x="312" y="230" width="24" height="30" rx="4" opacity="0.3" />
                    <rect x="344" y="230" width="24" height="30" rx="4" opacity="0.48" />
                    <rect x="428" y="148" width="22" height="28" rx="4" opacity="0.52" />
                    <rect x="458" y="148" width="22" height="28" rx="4" opacity="0.34" />
                    <rect x="428" y="188" width="22" height="28" rx="4" opacity="0.4" />
                    <rect x="458" y="188" width="22" height="28" rx="4" opacity="0.56" />
                    <rect x="428" y="228" width="22" height="28" rx="4" opacity="0.28" />
                    <rect x="458" y="228" width="22" height="28" rx="4" opacity="0.44" />
                </g>
                <path d="M28 338 H500" stroke="currentColor" stroke-width="1.2" opacity="0.22" stroke-linecap="round" />
                <path d="M40 352c70-28 140-42 220-42s150 14 220 42" stroke="#E7D0AA" stroke-width="1.4" opacity="0.28" stroke-linecap="round" />
                <circle cx="120" cy="96" r="3.5" fill="#E7D0AA" opacity="0.45" />
                <circle cx="248" cy="72" r="2.5" fill="#E7D0AA" opacity="0.35" />
                <circle cx="390" cy="88" r="3" fill="#E7D0AA" opacity="0.4" />
            </svg>
        </div>

        <div class="login-visual-stack">
            <div class="login-brand">
                <div class="login-brand-plate login-brand-plate--ninetyfive">
                    <img src="images/crewhop-logo-full.png?v=18" alt="CrewHop" />
                </div>
            </div>
            <div class="login-quote">
                <h1>Run your venues with the same calm clarity as the CrewHop app.</h1>
                <p>Check performance, launch promotions, and book ad space — built for busy operators.</p>
            </div>
        </div>

        <div class="login-portal-badge">Business portal</div>
    </section>

    <section class="login-panel">
        <div class="login-card">
            <h2>Sign in to your business</h2>
            <p class="lede">Use your email to open venues, promotions, and campaign stats.</p>

            <EditForm Model="_model" OnValidSubmit="HandleContinueAsync">
                <div class="field login-field">
                    <label for="email">Email</label>
                    <InputText id="email" @bind-Value="_model.Email" placeholder="demo@crewhop.com" autocomplete="username" />
                </div>
                <div class="field login-field">
                    <label for="password">Password</label>
                    <InputText id="password" type="password" @bind-Value="_model.Password" placeholder="••••••••" autocomplete="current-password" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-error" style="margin-bottom:0.9rem;">@_error</div>
                }

                <button class="btn btn-primary login-submit" type="submit" disabled="@_busy">
                    @(_busy ? "Opening…" : "Sign in")
                </button>
                <button type="button" class="login-forgot">Forgot password?</button>
            </EditForm>
        </div>
    </section>
</div>

@code {
    private readonly EntryModel _model = new()
    {
        Email = OperatorProfile.DemoEmail
    };
    private string _error = "";
    private bool _busy;

    private async Task HandleContinueAsync()
    {
        _error = "";
        var email = _model.Email.Trim();
        if (!email.Equals(OperatorProfile.DemoEmail, StringComparison.OrdinalIgnoreCase))
        {
            _error = $"This demo portal only accepts {OperatorProfile.DemoEmail}.";
            return;
        }

        if (!string.Equals(_model.Password, OperatorProfile.DemoPassword, StringComparison.Ordinal))
        {
            _error = "Incorrect password. Use the demo password.";
            return;
        }

        _busy = true;
        await Profile.SetAsync(OperatorProfile.DemoEmail, OperatorProfile.DemoDisplayName);
        _busy = false;
        Nav.NavigateTo("dashboard");
    }

    private sealed class EntryModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
